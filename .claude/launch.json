{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "server",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd server && .venv/bin/python -m uvicorn main:app --port 8000"],
      "port": 8000
    },
    {
      "name": "web",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd web && PATH=\"$HOME/.nvm/versions/node/v20.19.5/bin:$PATH\" npm run dev"
      ],
      "port": 5173
    }
  ]
}
