{
  "id": "ad36631f21174f59",
  "name": "settlement",
  "items": [
    {
      "type": "folder",
      "name": "정산",
      "items": [
        {
          "type": "http",
          "name": "정산 조회",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/customers/{{customerId}}/settlement",
            "headers": [
              {
                "name": "Authorization",
                "value": "Bearer {{authToken}}",
                "enabled": true,
                "description": "인증 토큰 (Bearer)"
              }
            ],
            "params": [],
            "body": {
              "mode": "none"
            },
            "output": [
              {
                "name": "settlementId",
                "label": "정산 ID"
              },
              {
                "name": "status",
                "label": "상태"
              },
              {
                "name": "amount",
                "label": "금액"
              }
            ]
          }
        },
        {
          "type": "http",
          "name": "정산 취소",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/settlements/{{settlementId}}/cancel",
            "headers": [
              {
                "name": "Authorization",
                "value": "Bearer {{authToken}}",
                "enabled": true,
                "description": "인증 토큰 (Bearer)"
              },
              {
                "name": "Content-Type",
                "value": "application/json",
                "enabled": true,
                "description": "요청 본문 형식"
              }
            ],
            "params": [],
            "body": {
              "mode": "json",
              "json": "{\"reason\": \"{{reason}}\"}"
            },
            "output": [
              {
                "name": "settlementId",
                "label": "정산 ID"
              },
              {
                "name": "status",
                "label": "상태"
              },
              {
                "name": "reason",
                "label": "사유"
              }
            ]
          }
        }
      ]
    }
  ],
  "environments": [
    {
      "name": "payments",
      "variables": [
        {
          "name": "baseUrl",
          "value": "http://localhost:9100/payments",
          "enabled": true
        },
        {
          "name": "authToken",
          "value": "vault://payments/api-token",
          "enabled": true
        }
      ]
    }
  ],
  "activeEnvironment": "payments"
}