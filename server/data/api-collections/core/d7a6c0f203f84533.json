                "name": "reason",
                "label": "사유"
              }
            ]
          }
        },
        {
          "type": "http",
          "name": "계좌 출금",
          "request": {
            "method": "POST",
            "url": "{{coreBaseUrl}}/accounts/{{accountNo}}/withdraw",
            "headers": [
              {
                "name": "Authorization",
