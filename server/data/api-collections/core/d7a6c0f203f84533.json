        {
          "type": "http",
          "name": "계좌 폐쇄",
          "request": {
            "method": "POST",
            "url": "{{coreBaseUrl}}/accounts/{{accountNo}}/close",
            "headers": [
              {
                "name": "Authorization",
                "value": "Bearer {{authToken}}",
                "enabled": true,
                "description": "인증 토큰 (Bearer)"
              },
              {
                "name": "Content-Type",
                "value": "application/json",
                "enabled": true,
                "description": "요청 본문 형식"
              }
            ],
            "params": [],
            "body": {
              "mode": "json",
              "json": "{\"reason\": \"{{reason}}\"}"
            },
            "output": [
              {
                "name": "accountNo",
                "label": "계좌번호"
              },
              {
                "name": "status",
                "label": "상태"
