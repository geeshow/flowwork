            "params": [],
            "body": {
              "mode": "json",
              "json": "{\"amount\": {{amount}}, \"password\": \"{{password}}\"}"
            },
            "output": [
              {
                "name": "accountNo",
                "label": "계좌번호"
              },
              {
                "name": "status",
                "label": "상태"
