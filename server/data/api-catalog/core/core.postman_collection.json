{
  "info": {
    "name": "core",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "약정",
      "item": [
        {
          "name": "전체 약정 코드 목록 조회",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": {
              "raw": "{{coreBaseUrl}}/agreements/codes",
              "host": ["{{coreBaseUrl}}"],
              "path": ["agreements", "codes"]
            }
          }
        }
      ]
    },
    {
      "name": "사용자",
      "item": [
        {
          "name": "사용자 정보 조회",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": {
              "raw": "{{coreBaseUrl}}/users/{{app_user_id}}",
              "host": ["{{coreBaseUrl}}"],
              "path": ["users", "{{app_user_id}}"]
            }
          }
        }
      ]
    },
    {
      "name": "계좌",
      "item": [
        {
          "name": "계좌 목록 조회",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": {
              "raw": "{{coreBaseUrl}}/users/{{app_user_id}}/accounts?status={{account_status}}",
              "host": ["{{coreBaseUrl}}"],
              "path": ["users", "{{app_user_id}}", "accounts"],
              "query": [{ "key": "status", "value": "{{account_status}}" }]
            }
          }
        },
        {
          "name": "계좌 목록 조회 (보안ID)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": {
              "raw": "{{coreBaseUrl}}/accounts?sec_user_id={{sec_user_id}}",
              "host": ["{{coreBaseUrl}}"],
              "path": ["accounts"],
              "query": [{ "key": "sec_user_id", "value": "{{sec_user_id}}" }]
            }
          }
        }
      ]
    },
    {
      "name": "메타코드",
      "item": [
        {
          "name": "계좌 활성 상태 코드",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": {
              "raw": "{{coreBaseUrl}}/meta/codes/account_status",
              "host": ["{{coreBaseUrl}}"],
              "path": ["meta", "codes", "account_status"]
            }
          }
        },
        {
          "name": "사용자 상태 코드",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": {
              "raw": "{{coreBaseUrl}}/meta/codes/user_status",
              "host": ["{{coreBaseUrl}}"],
              "path": ["meta", "codes", "user_status"]
            }
          }
        },
        {
          "name": "메타 코드 조회",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": {
              "raw": "{{coreBaseUrl}}/meta/codes/{{code_group}}",
              "host": ["{{coreBaseUrl}}"],
              "path": ["meta", "codes", "{{code_group}}"]
            }
          }
        }
      ]
    }
  ]
}
