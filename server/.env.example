# 프록시 SSRF 방지용 host allowlist (콤마 구분 URL prefix)
FLOWWORK_ALLOWED_HOST_PREFIXES=http://localhost,http://127.0.0.1

# 프록시 타임아웃(초)
FLOWWORK_PROXY_TIMEOUT=15.0

# 데이터 디렉토리 (기본: server/data) — git 저장소여야 편집(git) 기능이 동작한다.
# 워크플로우 설정 데이터는 별도 저장소로 관리: https://github.com/geeshow/flowwork-workdata
# FLOWWORK_DATA_DIR=/abs/path/to/flowwork-workdata

# 브랜치별 편집 worktree 부모 경로 (기본: {FLOWWORK_DATA_DIR}-edit — 자동 생성)
# 하위에 develop/, feature__{이름}/ worktree가 브랜치마다 만들어진다 (동시 편집)
# FLOWWORK_EDIT_DATA_DIR=/abs/path/to/flowwork-workdata-edit

# 브랜치 체계 (기본: master=운영, develop=편집 기준)
# FLOWWORK_PROD_BRANCH=master
# FLOWWORK_EDIT_BASE_BRANCH=develop

# 시크릿 (vault://scope/key → SECRET_{SCOPE}_{KEY})
# 예: vault://payments/api-token
SECRET_PAYMENTS_API_TOKEN=dev-token-example
